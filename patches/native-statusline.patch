@@ -0,0 +1,79 @@
+//! Command rows stay distinct while wrapping within the native footer viewport.
+
+use ratatui::text::Line;
+use ratatui::text::Span;
+use unicode_segmentation::UnicodeSegmentation;
+
+use crate::style::secondary_text_style;
+use crate::width::display_width;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct CommandStatusLine {
+    rows: Vec<Line<'static>>,
+}
+
+impl CommandStatusLine {
+    pub(crate) fn from_fixed_rows(rows: Vec<Line<'static>>) -> Option<Self> {
+        let rows = rows
+            .into_iter()
+            .filter(|row| row.spans.iter().any(|span| !span.content.is_empty()))
+            .collect::<Vec<_>>();
+        (!rows.is_empty()).then_some(Self { rows })
+    }
+
+    pub(crate) fn to_line(&self) -> Line<'static> {
+        let mut spans = Vec::new();
+        for row in &self.rows {
+            if !spans.is_empty() {
+                spans.push(Span::styled(" · ", secondary_text_style()));
+            }
+            spans.extend(
+                row.spans.iter().map(|span| {
+                    Span::styled(span.content.to_string(), row.style.patch(span.style))
+                }),
+            );
+        }
+        Line::from(spans)
+    }
+
+    pub(crate) fn layout(&self, width: usize) -> Vec<Line<'static>> {
+        if width == 0 {
+            return Vec::new();
+        }
+        let mut result = Vec::new();
+        for row in &self.rows {
+            let mut spans: Vec<Span<'static>> = Vec::new();
+            let mut used: usize = 0;
+            for span in &row.spans {
+                let style = row.style.patch(span.style);
+                for grapheme in span.content.graphemes(true) {
+                    let cells = display_width(grapheme);
+                    if !spans.is_empty() && used.saturating_add(cells) > width {
+                        result.push(Line::from(std::mem::take(&mut spans)));
+                        used = 0;
+                    }
+                    if let Some(previous) = spans.last_mut()
+                        && previous.style == style
+                    {
+                        previous.content.to_mut().push_str(grapheme);
+                    } else {
+                        spans.push(Span::styled(grapheme.to_string(), style));
+                    }
+                    used = used.saturating_add(cells);
+                    if used >= width {
+                        result.push(Line::from(std::mem::take(&mut spans)));
+                        used = 0;
+                    }
+                }
+            }
+            if !spans.is_empty() {
+                result.push(Line::from(spans));
+            }
+        }
+        result
+    }
+}
