+++ b/codex-rs/tui/src/bottom_pane/status_line.rs
@@ -0,0 +1,395 @@
+use ratatui::prelude::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use unicode_segmentation::UnicodeSegmentation;
+
+use crate::line_truncation::line_width;
+use crate::width::display_width;
+
+const FIELD_SEPARATOR: &str = " · ";
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct StatusLine {
+    fields: Vec<Line<'static>>,
+    fixed_rows: Option<Vec<Line<'static>>>,
+}
+
+impl StatusLine {
+    pub(crate) fn from_fields(fields: Vec<Line<'static>>) -> Option<Self> {
+        (!fields.is_empty()).then_some(Self {
+            fields,
+            fixed_rows: None,
+        })
+    }
+
+    pub(crate) fn from_line(line: Line<'static>) -> Self {
+        Self {
+            fields: vec![line],
+            fixed_rows: None,
+        }
+    }
+
+    /// Creates a status line whose source rows remain distinct during layout.
+    pub(crate) fn from_fixed_rows(rows: Vec<Line<'static>>) -> Option<Self> {
+        let rows = rows.into_iter().filter(has_text).collect::<Vec<_>>();
+        (!rows.is_empty()).then_some(Self {
+            fields: Vec::new(),
+            fixed_rows: Some(rows),
+        })
+    }
+
+    pub(crate) fn push_field(&mut self, field: Line<'static>) {
+        if let Some(rows) = self.fixed_rows.as_mut() {
+            if let Some(last_row) = rows.last_mut() {
+                if has_text(last_row) {
+                    last_row.spans.push(FIELD_SEPARATOR.dim());
+                }
+                append_line_spans(&mut last_row.spans, &field);
+            } else {
+                rows.push(field);
+            }
+        } else {
+            self.fields.push(field);
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn text(&self) -> String {
+        self.fixed_rows
+            .as_ref()
+            .unwrap_or(&self.fields)
+            .iter()
+            .filter(|field| has_text(field))
+            .map(line_text)
+            .collect::<Vec<_>>()
+            .join(if self.fixed_rows.is_some() {
+                "\n"
+            } else {
+                FIELD_SEPARATOR
+            })
+    }
+
+    pub(crate) fn to_line(&self) -> Line<'static> {
+        join_fields(
+            self.fixed_rows
+                .as_ref()
+                .unwrap_or(&self.fields)
+                .iter()
+                .cloned(),
+        )
+    }
+
+    pub(crate) fn layout(&self, width: usize) -> Vec<Line<'static>> {
+        if width == 0 {
+            return Vec::new();
+        }
+
+        if let Some(rows) = self.fixed_rows.as_ref() {
+            return rows
+                .iter()
+                .flat_map(|row| {
+                    pack_into_capacities(
+                        std::slice::from_ref(row),
+                        &[width],
+                        RowCapacityMode::RepeatLast,
+                    )
+                    .unwrap_or_default()
+                })
+                .collect();
+        }
+
+        pack_into_capacities(&self.fields, &[width], RowCapacityMode::RepeatLast)
+            .unwrap_or_else(|| unreachable!("a repeated positive row width fits every field"))
+    }
+
+    pub(crate) fn layout_with_last_width(
+        &self,
+        width: usize,
+        last_width: usize,
+    ) -> Option<Vec<Line<'static>>> {
+        if width == 0 || last_width == 0 {
+            return None;
+        }
+
+        if let Some(rows) = self.fixed_rows.as_ref() {
+            let (last, leading) = rows.split_last()?;
+            let mut lines = leading
+                .iter()
+                .flat_map(|row| {
+                    pack_into_capacities(
+                        std::slice::from_ref(row),
+                        &[width],
+                        RowCapacityMode::RepeatLast,
+                    )
+                    .unwrap_or_default()
+                })
+                .collect::<Vec<_>>();
+            let trailing =
+                Self::from_line(last.clone()).layout_with_last_width(width, last_width)?;
+            lines.extend(trailing);
+            return Some(lines);
+        }
+
+        let full_layout = self.layout(width);
+        let final_line = full_layout.last()?;
+        if final_line.width() <= last_width {
+            return Some(full_layout);
+        }
+
+        let fields = self
+            .fields
+            .iter()
+            .filter(|field| has_text(field))
+            .cloned()
+            .collect::<Vec<_>>();
+        let separator_width = display_width(FIELD_SEPARATOR);
+        let mut suffix_fields = Vec::new();
+        let mut suffix_width = 0usize;
+        let mut prefix_count = fields.len();
+
+        while let Some(field) = prefix_count
+            .checked_sub(1)
+            .and_then(|index| fields.get(index))
+        {
+            let field_width = line_width(field);
+            let gap_width = usize::from(!suffix_fields.is_empty()).saturating_mul(separator_width);
+            let combined_width = field_width
+                .saturating_add(gap_width)
+                .saturating_add(suffix_width);
+            if combined_width <= last_width {
+                suffix_fields.push(field.clone());
+                suffix_width = combined_width;
+                prefix_count = prefix_count.saturating_sub(1);
+                continue;
+            }
+
+            if suffix_fields.is_empty() {
+                if field_width <= width {
+                    return None;
+                }
+                let mut graphemes = field
+                    .spans
+                    .iter()
+                    .flat_map(|span| {
+                        let style = field.style.patch(span.style);
+                        span.content
+                            .graphemes(/*is_extended*/ true)
+                            .map(move |grapheme| {
+                                (
+                                    Span::styled(grapheme.to_string(), style),
+                                    display_width(grapheme),
+                                )
+                            })
+                    })
+                    .collect::<Vec<_>>();
+                let mut suffix_start = graphemes.len();
+                let mut split_suffix_width = 0usize;
+                while let Some((_, grapheme_width)) = suffix_start
+                    .checked_sub(1)
+                    .and_then(|index| graphemes.get(index))
+                {
+                    if split_suffix_width.saturating_add(*grapheme_width) > last_width {
+                        break;
+                    }
+                    split_suffix_width = split_suffix_width.saturating_add(*grapheme_width);
+                    suffix_start = suffix_start.saturating_sub(1);
+                }
+                if suffix_start == graphemes.len() {
+                    return None;
+                }
+
+                let suffix_graphemes = graphemes.split_off(suffix_start);
+                let mut prefix_spans = Vec::new();
+                for (span, _) in graphemes {
+                    append_span(&mut prefix_spans, span);
+                }
+                let mut suffix_spans = Vec::new();
+                for (span, _) in suffix_graphemes {
+                    append_span(&mut suffix_spans, span);
+                }
+
+                let mut prefix_fields = fields[..prefix_count.saturating_sub(1)].to_vec();
+                if !prefix_spans.is_empty() {
+                    prefix_fields.push(Line::from(prefix_spans));
+                }
+                suffix_fields.push(Line::from(suffix_spans));
+
+                let mut lines =
+                    pack_into_capacities(&prefix_fields, &[width], RowCapacityMode::RepeatLast)?;
+                lines.extend(pack_into_capacities(
+                    &suffix_fields,
+                    &[last_width],
+                    RowCapacityMode::Fixed,
+                )?);
+                return Some(lines);
+            }
+            break;
+        }
+
+        suffix_fields.reverse();
+        let mut lines = pack_into_capacities(
+            &fields[..prefix_count],
+            &[width],
+            RowCapacityMode::RepeatLast,
+        )?;
+        lines.extend(pack_into_capacities(
+            &suffix_fields,
+            &[last_width],
+            RowCapacityMode::Fixed,
+        )?);
+        Some(lines)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum RowCapacityMode {
+    Fixed,
+    RepeatLast,
+}
+
+#[cfg(test)]
+fn line_text(line: &Line<'_>) -> String {
+    line.spans
+        .iter()
+        .map(|span| span.content.as_ref())
+        .collect()
+}
+
+fn has_text(line: &Line<'_>) -> bool {
+    line.spans.iter().any(|span| !span.content.is_empty())
+}
+
+fn join_fields(fields: impl IntoIterator<Item = Line<'static>>) -> Line<'static> {
+    let mut spans = Vec::new();
+
+    for field in fields {
+        if !has_text(&field) {
+            continue;
+        }
+        if !spans.is_empty() {
+            spans.push(FIELD_SEPARATOR.dim());
+        }
+        append_line_spans(&mut spans, &field);
+    }
+
+    Line::from(spans)
+}
+
+fn pack_into_capacities(
+    fields: &[Line<'static>],
+    capacities: &[usize],
+    mode: RowCapacityMode,
+) -> Option<Vec<Line<'static>>> {
+    let mut rows = Vec::new();
+    let mut row_spans = Vec::new();
+    let mut row_width = 0;
+
+    for field in fields {
+        if !has_text(field) {
+            continue;
+        }
+
+        let field_width = line_width(field);
+        let capacity = row_capacity(capacities, rows.len(), mode)?;
+        if row_spans.is_empty() && field_width <= capacity {
+            append_line_spans(&mut row_spans, field);
+            row_width = field_width;
+            continue;
+        }
+
+        let separator_width = display_width(FIELD_SEPARATOR);
+        if !row_spans.is_empty()
+            && row_width
+                .saturating_add(separator_width)
+                .saturating_add(field_width)
+                <= capacity
+        {
+            append_span(&mut row_spans, FIELD_SEPARATOR.dim());
+            append_line_spans(&mut row_spans, field);
+            row_width = row_width
+                .saturating_add(separator_width)
+                .saturating_add(field_width);
+            continue;
+        }
+
+        if !row_spans.is_empty() {
+            rows.push(Line::from(std::mem::take(&mut row_spans)));
+            row_width = 0;
+        }
+
+        let capacity = row_capacity(capacities, rows.len(), mode)?;
+        if field_width <= capacity {
+            append_line_spans(&mut row_spans, field);
+            row_width = field_width;
+            continue;
+        }
+
+        for span in &field.spans {
+            let source_style = field.style.patch(span.style);
+            for grapheme in span.content.graphemes(/*is_extended*/ true) {
+                let grapheme_width = display_width(grapheme);
+                let capacity = row_capacity(capacities, rows.len(), mode)?;
+                if !row_spans.is_empty() && row_width.saturating_add(grapheme_width) > capacity {
+                    rows.push(Line::from(std::mem::take(&mut row_spans)));
+                    row_width = 0;
+                }
+
+                let capacity = row_capacity(capacities, rows.len(), mode)?;
+                if mode == RowCapacityMode::Fixed && grapheme_width > capacity {
+                    return None;
+                }
+
+                append_span(
+                    &mut row_spans,
+                    Span::styled(grapheme.to_string(), source_style),
+                );
+                row_width = row_width.saturating_add(grapheme_width);
+
+                if row_width >= capacity {
+                    rows.push(Line::from(std::mem::take(&mut row_spans)));
+                    row_width = 0;
+                }
+            }
+        }
+    }
+
+    if !row_spans.is_empty() {
+        rows.push(Line::from(row_spans));
+    }
+
+    Some(rows)
+}
+
+fn row_capacity(capacities: &[usize], row_index: usize, mode: RowCapacityMode) -> Option<usize> {
+    let capacity = match mode {
+        RowCapacityMode::Fixed => capacities.get(row_index).copied(),
+        RowCapacityMode::RepeatLast => capacities
+            .get(row_index)
+            .copied()
+            .or_else(|| capacities.last().copied()),
+    }?;
+    (capacity > 0).then_some(capacity)
+}
+
+fn append_line_spans(destination: &mut Vec<Span<'static>>, line: &Line<'static>) {
+    for span in &line.spans {
+        destination.push(Span::styled(
+            span.content.to_string(),
+            line.style.patch(span.style),
+        ));
+    }
+}
+
+fn append_span(destination: &mut Vec<Span<'static>>, span: Span<'static>) {
+    if let Some(previous) = destination.last_mut()
+        && previous.style == span.style
+    {
+        previous.content.to_mut().push_str(span.content.as_ref());
+    } else {
+        destination.push(span);
+    }
+}
+
