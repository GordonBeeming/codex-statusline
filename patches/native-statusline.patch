diff --git a/codex-rs/tui/src/bottom_pane/status_line_tests.rs b/codex-rs/tui/src/bottom_pane/status_line_tests.rs
new file mode 100644
index 0000000000..a7ef1e3ae9
--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/status_line_tests.rs
@@ -0,0 +1,164 @@
+use super::StatusLine;
+use pretty_assertions::assert_eq;
+use ratatui::prelude::Stylize;
+use ratatui::text::Line;
+
+#[test]
+fn wraps_at_field_boundaries_across_all_required_rows() {
+    let status = StatusLine::from_fields(vec![
+        Line::from("model"),
+        Line::from("branch"),
+        Line::from("context"),
+        Line::from("tokens"),
+    ])
+    .expect("status line");
+
+    assert_eq!(
+        status.layout(/*width*/ 10),
+        vec![
+            Line::from("model"),
+            Line::from("branch"),
+            Line::from("context"),
+            Line::from("tokens"),
+        ]
+    );
+}
+
+#[test]
+fn keeps_fields_together_when_the_combination_fits() {
+    let status =
+        StatusLine::from_fields(vec![Line::from("one"), Line::from("two")]).expect("status line");
+
+    assert_eq!(
+        status.layout(/*width*/ 9),
+        vec![Line::from(vec!["one".into(), " · ".dim(), "two".into()])]
+    );
+}
+
+#[test]
+fn oversized_fields_wrap_on_graphemes_and_preserve_styles() {
+    let field = Line::from(vec!["中文".cyan(), "👩‍💻e\u{301}".magenta().underlined()]);
+    let status = StatusLine::from_fields(vec![field]).expect("status line");
+    let lines = status.layout(/*width*/ 4);
+
+    assert_eq!(
+        lines,
+        vec![
+            Line::from("中文".cyan()),
+            Line::from("👩‍💻e\u{301}".magenta().underlined()),
+        ]
+    );
+}
+
+#[test]
+fn exhausted_width_is_safe() {
+    let status = StatusLine::from_fields(vec![Line::from("field")]).expect("status line");
+
+    assert_eq!(status.layout(/*width*/ 0), Vec::<Line<'static>>::new());
+    assert_eq!(
+        status.layout_with_last_width(/*width*/ 0, /*last_width*/ 0),
+        None
+    );
+}
+
+#[test]
+fn flattened_conversion_preserves_field_spans_and_styles() {
+    let mut status = StatusLine::from_line(Line::from(vec!["model".cyan(), " name".cyan()]).bold());
+    status.push_field(Line::from("branch").magenta());
+
+    assert_eq!(status.text(), "model name · branch");
+    assert_eq!(
+        status.to_line(),
+        Line::from(vec![
+            "model".cyan().bold(),
+            " name".cyan().bold(),
+            " · ".dim(),
+            "branch".magenta(),
+        ])
+    );
+}
+
+#[test]
+fn constrained_last_row_rejects_an_indivisible_wide_grapheme() {
+    let status = StatusLine::from_fields(vec![Line::from("abc中")]).expect("status line");
+
+    assert_eq!(
+        status.layout_with_last_width(/*width*/ 4, /*last_width*/ 1),
+        None
+    );
+}
+
+#[test]
+fn constrained_last_row_does_not_split_a_field_that_fits_the_normal_width() {
+    let status = StatusLine::from_fields(vec![Line::from("abcd")]).expect("status line");
+
+    assert_eq!(
+        status.layout_with_last_width(/*width*/ 4, /*last_width*/ 2),
+        None
+    );
+}
+
+#[test]
+fn constrained_last_row_reflows_whole_fields_across_earlier_rows() {
+    let status = StatusLine::from_fields(vec![
+        Line::from("aaaaaa"),
+        Line::from("bb"),
+        Line::from("cc"),
+    ])
+    .expect("status line");
+
+    assert_eq!(
+        status.layout_with_last_width(/*width*/ 10, /*last_width*/ 2),
+        Some(vec![
+            Line::from("aaaaaa"),
+            Line::from("bb"),
+            Line::from("cc"),
+        ])
+    );
+}
+
+#[test]
+fn constrained_last_row_splits_graphemes_and_preserves_styles() {
+    let field = Line::from(vec![
+        "ab".cyan(),
+        "中文".magenta().underlined(),
+        "z".green(),
+    ])
+    .bold();
+    let status = StatusLine::from_fields(vec![field]).expect("status line");
+
+    assert_eq!(
+        status.layout_with_last_width(/*width*/ 5, /*last_width*/ 2),
+        Some(vec![
+            Line::from(vec!["ab".cyan().bold(), "中".magenta().underlined().bold()]),
+            Line::from("文".magenta().underlined().bold()),
+            Line::from("z".green().bold()),
+        ])
+    );
+}
+
+#[test]
+fn omits_separators_around_empty_fields() {
+    let status = StatusLine::from_fields(vec![
+        Line::from("model"),
+        Line::default(),
+        Line::from("branch"),
+        Line::default(),
+    ])
+    .expect("status line");
+
+    assert_eq!(status.text(), "model · branch");
+    assert_eq!(
+        status.to_line(),
+        Line::from(vec!["model".into(), " · ".dim(), "branch".into()])
+    );
+}
+
+#[test]
+fn maximum_capacity_is_safe() {
+    let status =
+        StatusLine::from_fields(vec![Line::from("one"), Line::from("two")]).expect("status line");
+    let expected = vec![Line::from(vec!["one".into(), " · ".dim(), "two".into()])];
+
+    assert_eq!(status.layout(usize::MAX), expected);
+}
