+use super::*;
+use pretty_assertions::assert_eq;
+
+fn command(argv: &[&str]) -> TuiStatusLineCommand {
+    TuiStatusLineCommand {
+        command: argv.iter().map(|arg| (*arg).to_string()).collect(),
+        refresh_interval_ms: 1_000,
+        timeout_ms: 250,
+        max_lines: 4,
+    }
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn command_receives_json_and_preserves_multiple_lines() {
+    let result = run_status_line_command(
+        &command(&[
+            "sh",
+            "-c",
+            "read payload; printf 'one\\ntwo\\n%s\\n' \"$payload\"",
+        ]),
+        r#"{"schema_version":1}"#,
+        Path::new("/tmp"),
+    )
+    .await;
+
+    assert_eq!(
+        result,
+        Ok(Some(vec![
+            "one".to_string(),
+            "two".to_string(),
+            r#"{"schema_version":1}"#.to_string(),
+        ]))
+    );
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn command_timeout_keeps_the_tui_bounded() {
+    let mut config = command(&["sh", "-c", "sleep 2"]);
+    config.timeout_ms = 25;
+
+    assert_eq!(
+        run_status_line_command(&config, "{}", Path::new("/tmp")).await,
+        Err("status-line command timed out".to_string())
+    );
+}
+
+#[test]
+fn sanitizer_keeps_sgr_and_removes_terminal_controls() {
+    assert_eq!(
+        sanitize_status_line("\u{1b}[31mred\u{1b}[0m\u{1b}]0;owned\u{7}safe\u{202e}"),
+        "\u{1b}[31mred\u{1b}[0msafe"
+    );
+}
+
+#[tokio::test]
+async fn idle_status_line_command_schedules_the_next_refresh() {
+    let (mut chat, _sender, _events, _operations) =
+        crate::chatwidget::tests::make_chatwidget_manual_with_sender().await;
+    let mut config = command(&["sh", "-c", "cat"]);
+    config.refresh_interval_ms = 60_000;
+    chat.config.tui_status_line_command = Some(config);
+    let (requester, mut frames) = crate::tui::FrameRequester::test_channel();
+    chat.frame_requester = requester;
+    let now = Instant::now();
+    chat.request_status_line_command_if_due(now);
+    let request_id = chat
+        .status_line_command
+        .pending_request_id
+        .expect("request started");
+    assert!(chat.set_status_line_command_output(request_id, Ok(Some(vec!["ready".into()]))));
+    assert!(chat.status_line_command.pending_request_id.is_none());
+    let scheduled = frames.try_recv().expect("idle refresh scheduled");
+    assert!(scheduled > now + Duration::from_secs(55));
+    assert!(scheduled < now + Duration::from_secs(61));
+    chat.request_status_line_command_if_due(now + Duration::from_secs(60));
+    assert!(chat.status_line_command.pending_request_id.is_some());
+}
+
+#[test]
+fn sanitizer_preserves_text_after_csi_final_bytes() {
+    for sequence in [
+        "\u{1b}[K",
+        "\u{1b}[H",
+        "\u{1b}[2J",
+        "\u{1b}[?25l",
+        "\u{1b}[1 q",
+        "\u{1b}[0~",
+    ] {
+        assert_eq!(
+            sanitize_status_line(&format!("{sequence} 12 foo")),
+            " 12 foo"
+        );
+    }
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn command_can_close_stdin_without_consuming_the_payload() {
+    let mut config = command(&["sh", "-c", "exec 0<&-; printf ready"]);
+    config.timeout_ms = 5_000;
+    let payload = "x".repeat(1024 * 1024);
+    assert_eq!(
+        run_status_line_command(&config, &payload, Path::new("/tmp")).await,
+        Ok(Some(vec!["ready".to_string()]))
+    );
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn command_closing_stdin_still_reports_a_failed_exit() {
+    let mut config = command(&["sh", "-c", "exec 0<&-; printf stale; exit 7"]);
+    config.timeout_ms = 5_000;
+    let payload = "x".repeat(1024 * 1024);
+    let result = run_status_line_command(&config, &payload, Path::new("/tmp")).await;
+    assert!(
+        matches!(result, Err(error) if error.contains("exited with")),
+        "nonzero exit must fail"
+    );
+}
+
+#[tokio::test]
+async fn changed_payload_respects_the_refresh_interval() {
+    let (mut chat, _sender, _events, _operations) =
+        crate::chatwidget::tests::make_chatwidget_manual_with_sender().await;
+    let mut config = command(&["sh", "-c", "cat"]);
+    config.refresh_interval_ms = 60_000;
+    chat.config.tui_status_line_command = Some(config);
+    let now = Instant::now();
+    chat.request_status_line_command_if_due(now);
+    let request_id = chat
+        .status_line_command
+        .pending_request_id
+        .expect("request started");
+    assert!(chat.set_status_line_command_output(request_id, Ok(Some(vec!["ready".into()]))));
+    chat.thread_name = Some("Changed session name".into());
+    chat.request_status_line_command_if_due(now + Duration::from_secs(1));
+    assert!(
+        chat.status_line_command.pending_request_id.is_none(),
+        "changed payload must wait for the interval"
+    );
+    chat.request_status_line_command_if_due(now + Duration::from_secs(60));
+    assert!(chat.status_line_command.pending_request_id.is_some());
+}
