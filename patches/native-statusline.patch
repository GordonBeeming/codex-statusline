+#[tokio::test]
+async fn status_line_hyperlink_marks_later_row_pull_request_number_cells() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.show_welcome_banner = false;
+    chat.bottom_pane.set_status_line_enabled(/*enabled*/ true);
+    chat.set_status_line(StatusLine::from_fields(vec![
+        Line::from("gpt-5.4 high"),
+        Line::from("feature/multiline-footer"),
+        Line::from("Context 70% used"),
+        Line::from(Span::styled(
+            "PR #20252",
+            Style::default().cyan().underlined(),
+        )),
+    ]));
+    let url = "https://github.com/openai/codex/pull/20252";
+    chat.set_status_line_hyperlink(Some(url.to_string()));
+
+    let width = 28;
+    let height = chat.desired_height(width);
+    let mut terminal =
+        ratatui::Terminal::new(TestBackend::new(width, height)).expect("create terminal");
+    terminal
+        .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+        .expect("render linked status footer");
+    let area = terminal.backend().buffer().area;
+    let marked_cells = (area.top()..area.bottom())
+        .flat_map(|y| (area.left()..area.right()).map(move |x| (x, y)))
+        .filter(|&(x, y)| terminal.backend().buffer()[(x, y)].symbol().contains(url))
+        .collect::<Vec<_>>();
+
+    assert_eq!(
+        marked_cells.len(),
+        "PR #20252".chars().filter(|ch| !ch.is_whitespace()).count()
+    );
+    let first_status_row = (area.top()..area.bottom())
+        .find(|&y| {
+            (area.left()..area.right())
+                .map(|x| terminal.backend().buffer()[(x, y)].symbol())
+                .collect::<String>()
+                .contains("gpt-5.4 high")
+        })
+        .expect("first status row");
+    assert!(
+        marked_cells.iter().all(|&(_, y)| y > first_status_row),
+        "PR hyperlink cells must be on a later status row"
+    );
+    let hyperlink_open = format!("\x1b]8;;{url}\x07");
+    let visible_footer = (area.top()..area.bottom())
+        .flat_map(|y| (area.left()..area.right()).map(move |x| (x, y)))
+        .map(|(x, y)| terminal.backend().buffer()[(x, y)].symbol())
+        .collect::<String>()
+        .replace(&hyperlink_open, "")
+        .replace("\x1b]8;;\x07", "");
+    assert!(visible_footer.contains("PR #20252"));
+}
