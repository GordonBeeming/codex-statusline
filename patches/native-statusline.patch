+fn effort_transition_is_bypassed_for_a_multiline_footer() {
+    let (mut composer, _rx) = new_test_composer();
+    composer.set_status_line_enabled(/*enabled*/ true);
+    composer.set_collaboration_modes_enabled(/*enabled*/ true);
+    composer.set_collaboration_mode_indicator(Some(CollaborationModeIndicator::Plan));
+    composer.set_status_line(StatusLine::from_fields(vec![
+        Line::from("gpt-5.4 high"),
+        Line::from("feature-branch"),
+    ]));
+    composer.set_active_reasoning_effort(
+        Some(&ReasoningEffort::High),
+        /*animations_enabled*/ true,
+    );
+    composer.set_active_reasoning_effort(
+        Some(&ReasoningEffort::Ultra),
+        /*animations_enabled*/ true,
+    );
+
+    let width = 28;
+    assert_eq!(composer.footer_hint_height(width), 2);
+    let area = Rect::new(
+        /*x*/ 0,
+        /*y*/ 0,
+        width,
+        composer.desired_height(width),
+    );
+    let mut buf = Buffer::empty(area);
+    composer.render(area, &mut buf);
+    let mut screen = String::new();
+    for y in area.top()..area.bottom() {
+        for x in area.left()..area.right() {
+            screen.push_str(buf[(x, y)].symbol());
+        }
+    }
+
+    assert!(screen.contains("gpt-5.4 high"));
+    assert!(screen.contains("feature-branch"));
+    assert!(screen.contains("Plan mode"));
