+use super::*;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::style::Style;
+
+#[test]
+fn command_status_line_keeps_source_rows_at_wide_and_narrow_widths() {
+    let line = CommandStatusLine::from_fixed_rows(vec!["first".into(), "second".into()]).unwrap();
+    let text = |width| {
+        line.layout(width)
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(text(80), vec!["first", "second"]);
+    assert_eq!(text(3), vec!["fir", "st", "sec", "ond"]);
+    assert_eq!(line.to_line().to_string(), "first · second");
+}
+
+#[test]
+fn command_status_line_preserves_styles_and_unicode_graphemes_when_wrapping() {
+    let line = CommandStatusLine::from_fixed_rows(vec![
+        Line::from(vec![
+            Span::styled("A👩‍💻", Style::default().fg(Color::Green)),
+            Span::styled("e\u{301}B", Style::default().add_modifier(Modifier::BOLD)),
+        ])
+        .style(Style::default().bg(Color::Blue)),
+    ])
+    .unwrap();
+    let rows = line.layout(2);
+    assert_eq!(
+        rows.iter().map(ToString::to_string).collect::<Vec<_>>(),
+        vec!["A", "👩‍💻", "e\u{301}B"]
+    );
+    assert_eq!(rows[1].spans[0].style.fg, Some(Color::Green));
+    assert_eq!(rows[1].spans[0].style.bg, Some(Color::Blue));
+    assert!(rows[2].spans[0].style.add_modifier.contains(Modifier::BOLD));
+}
+
+#[test]
+fn command_status_line_handles_empty_output_and_zero_width() {
+    assert!(CommandStatusLine::from_fixed_rows(vec![]).is_none());
+    assert!(CommandStatusLine::from_fixed_rows(vec![Line::default()]).is_none());
+    let line = CommandStatusLine::from_fixed_rows(vec!["ready".into()]).unwrap();
+    assert!(line.layout(0).is_empty());
+}
